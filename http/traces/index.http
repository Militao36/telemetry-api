                  }
                },
                {
                  "key": "db.statement",
                  "value": {
                    "stringValue": "select sum(registro_contas.valor + registro_contas.juros + registro_contas.multa - registro_contas.desconto) from `registro_contas` inner join `contas` on `contas`.`id` = `registro_contas`.`idConta` left join `clientes` on `clientes`.`id` = `contas`.`idCliente` left join `fornecedores` on `fornecedores`.`id` = `contas`.`idFornecedor` left join `forma_pagamentos` on `forma_pagamentos`.`id` = `contas`.`idFormaPagamento` where `contas`.`idEmpresa` = ? and `registro_contas`.`dataPagamento` &gt;= ? and `registro_contas`.`dataPagamento` &lt;= ? and (`contas`.`situacao` = ? or `contas`.`situacao` = ?) and `contas`.`tipo` = ?"
                  }
                }
              ],
