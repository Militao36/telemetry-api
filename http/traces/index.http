                {
                  "key": "db.statement",
                  "value": {
                    "stringValue": "select `contas`.`idEmpresa`, `clientes`.`nome`, `clientes`.`cpfCnpj`, `contas`.`tipo`, `contas`.`situacao`, `contas`.`data`, `contas`.`dataPagamento`, `contas`.`valorTotal`, `contas`.`valorPago`, `contas`.`valorRestante`, `contas`.`descricao`, `contas`.`idCategoria`, `contas`.`id`, `contas`.`idUnion`, `contas`.`idVenda`, `contas`.`idNota`, `contas`.`idNfse`, `contas`.`idConsulta`, `forma_pagamentos`.`tipo` as `formaPagamento`, `contas`.`numeracao`, `fornecedores`.`nomeFantasia` as `nomeFantasia`, `fornecedores`.`cpfCnpj` as `cnpjFornecedor`, `vendas`.`numero` as `numVenda`, `categorias_contas`.`nome` as `nomeCategoria`, (SELECT COUNT(c2.id) from contas c2 WHERE contas.idUnion = c2.idUnion) as totalContas, COALESCE((SELECT SUM(rgc.valor + rgc.juros + rgc.multa - rgc.desconto) FROM registro_contas rgc WHERE rgc.idConta = contas.id), 0) AS valorTotalRegistros, DATE_FORMAT(contas.data,'%Y-%m-%d') as data from `contas` left join `categorias_contas` on `categorias_contas`.`id` = `contas`.`idCategoria` left join `.."
                  }
                }
              ],
