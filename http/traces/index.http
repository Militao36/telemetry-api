                    "stringValue": "select sum(contas.valorRestante) from `contas` left join `clientes` on `clientes`.`id` = `contas`.`idCliente` left join `fornecedores` on `fornecedores`.`id` = `contas`.`idFornecedor` left join `forma_pagamentos` on `forma_pagamentos`.`id` = `contas`.`idFormaPagamento` where `contas`.`idEmpresa` = ? and `contas`.`data` &lt; ? and `contas`.`situacao` = ? and `contas`.`tipo` = ?"
                  }
                }
              ],
              "droppedAttributesCount": 0,
