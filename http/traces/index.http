                    "stringValue": "select sum(contas.valorTotal) from `contas` left join `clientes` on `clientes`.`id` = `contas`.`idCliente` left join `fornecedores` on `fornecedores`.`id` = `contas`.`idFornecedor` left join `forma_pagamentos` on `forma_pagamentos`.`id` = `contas`.`idFormaPagamento` where `contas`.`idEmpresa` = ? and `contas`.`idEmpresa` = ? and `contas`.`tipo` = ? and `contas`.`data` &gt;= ? and `contas`.`data` &lt;= ?"
                  }
                }
              ],
