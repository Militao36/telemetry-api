@baseUrl = http://localhost:3333/api/v1
@projectToken = paste-your-project-token-here

### Send OTLP traces
POST {{baseUrl}}/traces
Content-Type: application/json
Authorization: Bearer {{projectToken}}

{
  "resourceSpans": [
    {
      "resource": {
        "attributes": [
          {
            "key": "service.name",
            "value": {
              "stringValue": "example-service"
            }
          }
        ]
      },
      "scopeSpans": [
        {
          "scope": {
            "name": "@opentelemetry/instrumentation-http"
          },
          "spans": [
            {
              "traceId": "00000000000000000000000000000001",
              "spanId": "0000000000000001",
              "name": "GET /health",
              "kind": 2,
              "startTimeUnixNano": "1763147319779000000",
              "endTimeUnixNano": "1763147319780000000",
              "attributes": [
                {
                  "key": "http.method",
                  "value": {
                    "stringValue": "GET"
                  }
                },
                {
                  "key": "http.target",
                  "value": {
                    "stringValue": "/health"
                  }
                },
                {
                  "key": "http.status_code",
                  "value": {
                    "intValue": 200
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
